{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtcf.dev/schema/v1/ctfd-manifest.schema.json",
  "title": "CTFd Challenge Manifest (auto-generated)",
  "description": "Generated by `mtcf generate` at challenges/<category>/<name>/challenge.yml. Do not edit by hand. Consumed by CTFd via the platform integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "author",
    "category",
    "type",
    "flags",
    "state"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "value": {
      "type": ["integer", "null"],
      "description": "Static-scoring point value. null when type=dynamic."
    },
    "type": {
      "type": "string",
      "enum": ["standard", "dynamic"],
      "description": "CTFd's notion of type. 'dynamic' = decay scoring; not the same as MTCF's 'instanced' archetype."
    },
    "extra": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required when type=dynamic.",
      "properties": {
        "initial": { "type": "integer", "minimum": 1 },
        "decay": { "type": "integer", "minimum": 1 },
        "minimum": { "type": "integer", "minimum": 1 }
      }
    },
    "flags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "content"],
        "properties": {
          "type": { "enum": ["static", "regex"] },
          "content": { "type": "string", "minLength": 1 },
          "case_sensitive": {
            "type": "string",
            "enum": ["case_sensitive", "case_insensitive"]
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content", "cost"],
        "properties": {
          "content": { "type": "string" },
          "cost": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "connection_info": {
      "type": ["string", "null"],
      "description": "URL or host:port shown to players. For instanced challenges, points at the instancer endpoint."
    },
    "files": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Asset paths relative to the challenge dir. Uploaded as downloadable files in CTFd."
    },
    "state": {
      "type": "string",
      "enum": ["visible", "hidden"]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prerequisites": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "anonymize": { "type": "boolean", "default": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "dynamic" } } },
      "then": { "required": ["extra"] }
    }
  ]
}
