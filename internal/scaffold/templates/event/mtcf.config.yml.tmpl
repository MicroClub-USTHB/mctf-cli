# MTCF event config — generated by `mtcf init`.
# Schema: https://github.com/MicroClub-USTHB/mctf-cli/blob/main/schema/mtcf-config.schema.json
version: 1

event:
  name: "{{.EventName}}"
  slug: "{{.EventSlug}}"
  domain: "{{.Domain}}"
  flag_prefix: "{{.FlagPrefix}}"
  waves_number: 3
  current_wave: 1
  scoring:
    type: dynamic
    initial: 500
    decay: 10
    minimum: 100

profile: {{.Profile}}

categories:
  extended: []
  custom: []

registry:
  url: "ghcr.io/{{.EventSlug}}"
  # Auth via env: MTCF_REGISTRY_USER / MTCF_REGISTRY_TOKEN

deploy:
  mode: docker
  docker:
    network: "{{.EventSlug}}-net"
    ingress: traefik

platform:
  type: ctfd
  url: "https://{{.Domain}}"
  # Token via env: MTCF_CTFD_TOKEN

instancer:
  url: "https://instancer.{{.Domain}}"
  default_timeout: 1800
  default_extend_time: 900

challenges_dir: "./challenges"
