# Generated by `mctf infra` from mctf.config.yml. Do not edit: every
# `mctf infra plan|apply` overwrites this file.

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    hcloud = {
      source  = "hetznercloud/hcloud"
      version = "~> 1.48"
    }
  }
}

# API token from the HCLOUD_TOKEN environment variable.
provider "hcloud" {}

locals {
  name = {{hcl .Name}}
  labels = {
    "mctf-event" = {{hcl .EventSlug}}
  }
}

resource "hcloud_ssh_key" "operator" {
  name       = local.name
  public_key = file(pathexpand({{hcl .SSHPublicKey}}))
  labels     = local.labels
}

resource "hcloud_firewall" "event" {
  name   = local.name
  labels = local.labels

  rule {
    direction  = "in"
    protocol   = "icmp"
    source_ips = ["0.0.0.0/0", "::/0"]
  }
{{range .Ports}}
  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = {{hcl .}}
    source_ips = ["0.0.0.0/0", "::/0"]
  }
{{end}}}

resource "hcloud_server" "event" {
  name         = local.name
  server_type  = {{hcl .Size}}
  image        = {{hcl .Image}}
  location     = {{hcl .Region}}
  ssh_keys     = [hcloud_ssh_key.operator.id]
  firewall_ids = [hcloud_firewall.event.id]
  user_data    = file("${path.module}/cloud-init.yml")
  labels       = local.labels
}

output "ipv4" {
  description = "Public IPv4 of the event server (deploy.ssh.host, DNS A records)."
  value       = hcloud_server.event.ipv4_address
}

output "ipv6" {
  description = "Public IPv6 of the event server."
  value       = hcloud_server.event.ipv6_address
}
