# Generated by `mctf infra` from mctf.config.yml. Do not edit: every
# `mctf infra plan|apply` overwrites this file.

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    digitalocean = {
      source  = "digitalocean/digitalocean"
      version = "~> 2.40"
    }
  }
}

# API token from the DIGITALOCEAN_TOKEN environment variable.
provider "digitalocean" {}

locals {
  name = {{hcl .Name}}
}

resource "digitalocean_tag" "event" {
  name = local.name
}

resource "digitalocean_ssh_key" "operator" {
  name       = local.name
  public_key = file(pathexpand({{hcl .SSHPublicKey}}))
}

resource "digitalocean_droplet" "event" {
  name       = local.name
  image      = {{hcl .Image}}
  region     = {{hcl .Region}}
  size       = {{hcl .Size}}
  ssh_keys   = [digitalocean_ssh_key.operator.fingerprint]
  user_data  = file("${path.module}/cloud-init.yml")
  monitoring = true
  tags       = [digitalocean_tag.event.id]
}

resource "digitalocean_firewall" "event" {
  name        = local.name
  droplet_ids = [digitalocean_droplet.event.id]

  inbound_rule {
    protocol         = "icmp"
    source_addresses = ["0.0.0.0/0", "::/0"]
  }
{{range .Ports}}
  inbound_rule {
    protocol         = "tcp"
    port_range       = {{hcl .}}
    source_addresses = ["0.0.0.0/0", "::/0"]
  }
{{end}}
  # DigitalOcean firewalls drop all egress unless it is allowed explicitly.
  outbound_rule {
    protocol              = "tcp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }

  outbound_rule {
    protocol              = "udp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }

  outbound_rule {
    protocol              = "icmp"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
}

output "ipv4" {
  description = "Public IPv4 of the event server (deploy.ssh.host, DNS A records)."
  value       = digitalocean_droplet.event.ipv4_address
}

output "ipv6" {
  description = "Public IPv6 of the event server (empty unless IPv6 is enabled)."
  value       = digitalocean_droplet.event.ipv6_address
}
